<?xml version="1.0"?>
<package format="3">
  <name>benchmarks</name>
  <version>0.1.0</version>
  <description>Benchmark harness for the TIAGo therapy-room simulation.</description>
  <maintainer email="student@example.com">HRAI</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>action_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>empower</exec_depend>
  <exec_depend>gaze_estimation</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>llm_interaction</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
