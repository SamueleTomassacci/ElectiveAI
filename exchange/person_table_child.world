<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="person_table_child_room">

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.72 0.72 0.70 1</ambient>
      <background>0.78 0.82 0.86 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <!--
      CONFIGURAZIONE FINALE:

      Adulto  davanti a TIAGo:       x = 0.00, y = -2.15
      TIAGo   al centro:             x = 0.00, y =  0.00
      Bambino dietro TIAGo:          x = 0.00, y = +2.15
      Tavolo con libro sul lato +X:  x = 2.05, y =  0.00

      Le persone sono allineate lungo l'asse Y, non lungo X.
      Il tavolo non e' vicino al bambino: occupa uno dei lati liberi
      della stanza, di fianco a TIAGo.

      IMPORTANTE:
      Questo world NON spawna TIAGo.
      Per catturare tavolo e libro con la camera frontale, usa TIAGo con:

      x = 0
      y = 0
      z = 0
      yaw = 0

      Esempio:
      rosrun gazebo_ros spawn_model ... -x 0 -y 0 -z 0 -Y 0

      Con yaw = 0 TIAGo guarda verso +X, quindi verso il tavolo laterale.
      Le persone rimangono ai lati -Y e +Y del robot.
    -->

    <model name="person_table_child_room_shell">
      <static>true</static>

      <link name="floor">
        <pose>0 0 -0.025 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>8.4 5.6 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.4 5.6 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.70 0.70 0.66 1</ambient>
            <diffuse>0.70 0.70 0.66 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="north_wall">
        <pose>0 2.8 0.45 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>8.4 0.12 0.9</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.4 0.12 0.9</size>
            </box>
          </geometry>
          <material>
            <ambient>0.86 0.86 0.82 1</ambient>
            <diffuse>0.86 0.86 0.82 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="south_wall">
        <pose>0 -2.8 0.45 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>8.4 0.12 0.9</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.4 0.12 0.9</size>
            </box>
          </geometry>
          <material>
            <ambient>0.86 0.86 0.82 1</ambient>
            <diffuse>0.86 0.86 0.82 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="east_wall">
        <pose>4.2 0 0.45 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.12 5.6 0.9</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.12 5.6 0.9</size>
            </box>
          </geometry>
          <material>
            <ambient>0.86 0.86 0.82 1</ambient>
            <diffuse>0.86 0.86 0.82 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="west_wall">
        <pose>-4.2 0 0.45 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.12 5.6 0.9</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.12 5.6 0.9</size>
            </box>
          </geometry>
          <material>
            <ambient>0.86 0.86 0.82 1</ambient>
            <diffuse>0.86 0.86 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      ADULTO

      L'adulto è davanti a TIAGo, sul lato -Y.
      Mantiene l'orientamento della mesh con yaw = 3.14159.
      In questa posizione guarda verso il centro, quindi verso TIAGo.
    -->
    <model name="adult_person_in_front_of_tiago">
      <static>true</static>
      <pose>0.00 -2.15 0 0 0 3.14159</pose>

      <link name="link">
        <visual name="visual">
          <pose>0 0 0.02 0.04 0 0</pose>
          <geometry>
            <mesh>
              <uri>file:///root/exchange/exchange/models/person_standing/meshes/standing.dae</uri>
            </mesh>
          </geometry>
        </visual>

        <collision name="bottom">
          <pose>0 -0.1 0.01 0 0 0</pose>
          <geometry>
            <box>
              <size>0.5 0.35 0.02</size>
            </box>
          </geometry>
        </collision>

        <collision name="body">
          <pose>0 -0.05 0.85 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.28</radius>
              <length>1.7</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!--
      BAMBINO

      Il bambino è dietro TIAGo, sul lato +Y.
      Mantiene l'orientamento della mesh con yaw = 0.
      In questa posizione guarda verso il centro, quindi verso TIAGo.
    -->
    <model name="child_straight_ahead_after_turn">
      <static>true</static>
      <pose>0.00 2.15 0 0 0 0</pose>

      <link name="link">
        <visual name="scaled_person_visual">
          <pose>0 0 0.02 0.04 0 0</pose>
          <geometry>
            <mesh>
              <uri>file:///root/exchange/exchange/models/person_standing/meshes/standing.dae</uri>
              <scale>0.64 0.64 0.64</scale>
            </mesh>
          </geometry>
        </visual>

        <collision name="bottom">
          <pose>0 -0.06 0.01 0 0 0</pose>
          <geometry>
            <box>
              <size>0.34 0.25 0.02</size>
            </box>
          </geometry>
        </collision>

        <collision name="body">
          <pose>0 -0.03 0.55 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.20</radius>
              <length>1.10</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!--
      TAVOLO LATERALE

      Il tavolo con il libro e' sul lato +X rispetto a TIAGo, che parte
      al centro della stanza. Rimane lontano dal bambino sul lato +Y.
    -->
    <model name="right_table_after_turn">
      <static>true</static>
      <pose>2.05 0.00 0 0 0 0.10</pose>

      <link name="top">
        <pose>0 0 0.72 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>1.12 0.78 0.08</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.12 0.78 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.43 0.27 0.13 1</ambient>
            <diffuse>0.53 0.33 0.16 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="legs">
        <pose>0 0 0.35 0 0 0</pose>

        <visual name="front_left">
          <pose>0.47 0.31 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.07 0.07 0.70</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.20 0.10 1</ambient>
            <diffuse>0.42 0.25 0.12 1</diffuse>
          </material>
        </visual>

        <visual name="front_right">
          <pose>0.47 -0.31 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.07 0.07 0.70</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.20 0.10 1</ambient>
            <diffuse>0.42 0.25 0.12 1</diffuse>
          </material>
        </visual>

        <visual name="back_left">
          <pose>-0.47 0.31 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.07 0.07 0.70</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.20 0.10 1</ambient>
            <diffuse>0.42 0.25 0.12 1</diffuse>
          </material>
        </visual>

        <visual name="back_right">
          <pose>-0.47 -0.31 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.07 0.07 0.70</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.20 0.10 1</ambient>
            <diffuse>0.42 0.25 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Libro rosso sul tavolo laterale -->
    <model name="clear_red_book_on_right_table">
      <static>true</static>
      <pose>2.16 -0.07 0.760 0 0 -0.18</pose>

      <link name="link">
        <collision name="collision">
          <pose>0 0 0.050 0 0 0</pose>
          <geometry>
            <box>
              <size>0.56 0.39 0.10</size>
            </box>
          </geometry>
        </collision>

        <visual name="page_block">
          <pose>0.025 0.010 0.050 0 0 0</pose>
          <geometry>
            <box>
              <size>0.50 0.33 0.085</size>
            </box>
          </geometry>
          <material>
            <ambient>0.86 0.83 0.70 1</ambient>
            <diffuse>0.98 0.94 0.80 1</diffuse>
          </material>
        </visual>

        <visual name="hard_cover_bottom">
          <pose>0 0 0.012 0 0 0</pose>
          <geometry>
            <box>
              <size>0.58 0.41 0.024</size>
            </box>
          </geometry>
          <material>
            <ambient>0.38 0.02 0.03 1</ambient>
            <diffuse>0.58 0.03 0.04 1</diffuse>
          </material>
        </visual>

        <visual name="hard_cover_top">
          <pose>0 0 0.102 0 0 0</pose>
          <geometry>
            <box>
              <size>0.58 0.41 0.024</size>
            </box>
          </geometry>
          <material>
            <ambient>0.58 0.03 0.04 1</ambient>
            <diffuse>0.86 0.04 0.05 1</diffuse>
          </material>
        </visual>

        <visual name="rounded_spine">
          <pose>-0.285 0 0.058 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.055</radius>
              <length>0.41</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.23 0.01 0.02 1</ambient>
            <diffuse>0.42 0.02 0.03 1</diffuse>
          </material>
        </visual>

        <visual name="front_page_edges">
          <pose>0.028 -0.177 0.060 0 0 0</pose>
          <geometry>
            <box>
              <size>0.48 0.018 0.060</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.75 0.62 1</ambient>
            <diffuse>0.94 0.90 0.74 1</diffuse>
          </material>
        </visual>

        <visual name="side_page_edges">
          <pose>0.285 0.010 0.060 0 0 0</pose>
          <geometry>
            <box>
              <size>0.018 0.32 0.060</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.75 0.62 1</ambient>
            <diffuse>0.94 0.90 0.74 1</diffuse>
          </material>
        </visual>

        <visual name="gold_title_plate">
          <pose>0.055 0.035 0.118 0 0 0</pose>
          <geometry>
            <box>
              <size>0.25 0.090 0.010</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.70 0.12 1</ambient>
            <diffuse>1.00 0.78 0.16 1</diffuse>
          </material>
        </visual>

        <visual name="gold_spine_line_upper">
          <pose>-0.250 0.115 0.120 0 0 0</pose>
          <geometry>
            <box>
              <size>0.020 0.130 0.012</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.70 0.12 1</ambient>
            <diffuse>1.00 0.78 0.16 1</diffuse>
          </material>
        </visual>

        <visual name="gold_spine_line_lower">
          <pose>-0.250 -0.115 0.120 0 0 0</pose>
          <geometry>
            <box>
              <size>0.020 0.130 0.012</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.70 0.12 1</ambient>
            <diffuse>1.00 0.78 0.16 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

  </world>
</sdf>
