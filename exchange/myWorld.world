    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.78 0.82 0.86 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- The room is shifted forward so TIAGo can spawn at the default origin without colliding with the scene. -->
